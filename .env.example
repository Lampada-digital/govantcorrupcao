# INTEGRA.GOV — Environment Configuration
# Copy this file to .env.local and fill in real values
# NEVER commit .env.local or .env with real values

# ============================================================
# APPLICATION
# ============================================================
VITE_APP_NAME=INTEGRA.GOV
VITE_APP_VERSION=1.0.0
VITE_APP_ENVIRONMENT=development

# ============================================================
# DATABASE (Production)
# ============================================================
DATABASE_URL=postgresql://user:password@localhost:5432/integra_gov
DATABASE_POOL_SIZE=10

# ============================================================
# AUTHENTICATION
# ============================================================
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRATION=8h
BCRYPT_ROUNDS=12
SESSION_SECRET=change-this-to-another-secure-random-string

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION_MS=900000

# ============================================================
# AI/LLM INTEGRATION (INTEGRAÇÃO PENDENTE)
# ============================================================
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.3

# ============================================================
# EXTERNAL DATA SOURCES (INTEGRAÇÃO PENDENTE)
# ============================================================
DATASOURCE_PORTAL_TRANSPARENCIA_URL=
DATASOURCE_PORTAL_TRANSPARENCIA_KEY=
DATASOURCE_RECEITA_FEDERAL_URL=
DATASOURCE_JUNTA_COMERCIAL_URL=

# ============================================================
# FILE STORAGE
# ============================================================
UPLOAD_MAX_SIZE_MB=50
UPLOAD_ALLOWED_TYPES=application/pdf,image/png,image/jpeg
STORAGE_PROVIDER=local
STORAGE_PATH=./uploads

# ============================================================
# SECURITY
# ============================================================
CORS_ORIGINS=http://localhost:3000
SECURITY_HEADERS_ENABLED=true
CSP_ENABLED=true

# ============================================================
# MONITORING
# ============================================================
LOG_LEVEL=info
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=false
